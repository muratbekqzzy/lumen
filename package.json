{
  "name": "lumen-hosted-sync",
  "private": true,
  "version": "1.0.0",
  "description": "Existing Lumen browser app with authenticated automatic cross-device synchronization",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node hosted/build.mjs",
    "test": "node --test cloud/*.test.cjs hosted/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "build:force": "node tools/build_force.mjs",
    "build:markdown": "node tools/build_markdown.mjs",
    "build:pdf": "node tools/build_pdf.mjs"
  },
  "devDependencies": {
    "d3-force": "^3.0.1",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.28.2",
    "markdown-it": "^15.0.3",
    "pdfjs-dist": "6.5.438"
  }
}
